//@version=6
indicator("XAUUSD - Aide au scalping (modèle en ligne)", shorttitle="XAU Scalp", overlay=false)

// ─────────────────────────────────────────────
// PARAMÈTRES
// ─────────────────────────────────────────────
lr      = input.float(0.02, "Taux d'apprentissage", minval=0.0001, step=0.005)
l2      = input.float(0.001, "Régularisation L2", minval=0.0, step=0.001)
zLen    = input.int(100, "Fenêtre de normalisation (z-score)", minval=20, maxval=300)
thrUp   = input.float(55.0, "Seuil de signal (%)", minval=50.0, maxval=80.0, step=0.5)
statLen = input.int(300, "Fenêtre des statistiques (barres)", minval=50, maxval=5000)
warmup = input.int(100, "Exemples d'apprentissage avant signal", minval=20, group="Scalping")
useTrend = input.bool(true, "Filtrer par tendance EMA 20/50", group="Scalping")
maxExtension = input.float(1.5, "Écart maximal à EMA 20 (ATR)", minval=0.1, step=0.1, group="Scalping")
maxRange = input.float(2.5, "Amplitude maximale de la bougie (ATR)", minval=0.5, step=0.1, group="Scalping")
cooldown = input.int(3, "Barres sans signal après une alerte", minval=0, group="Scalping")

// ─────────────────────────────────────────────
// OUTILS
// ─────────────────────────────────────────────
sigmoid(x) => 1.0 / (1.0 + math.exp(-math.max(-30.0, math.min(30.0, x))))
z(src) => math.max(-3.0, math.min(3.0, (src - ta.sma(src, zLen)) / math.max(ta.stdev(src, zLen), 1e-10)))
pct(value) => na(value) ? "—" : str.tostring(value, "#.0") + " %"

// ─────────────────────────────────────────────
// VARIABLES EXPLICATIVES (normalisées)
// ─────────────────────────────────────────────
atr14 = ta.atr(14)
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
f1 = z(ta.rsi(close, 14))                                   // momentum
f2 = z(ta.roc(close, 5))                                    // variation sur 5 barres
f3 = z((close - ta.ema(close, 20)) / math.max(atr14, syminfo.mintick)) // écart à l'EMA 20 en ATR
f4 = z(ta.atr(5) / math.max(ta.atr(50), syminfo.mintick))   // régime de volatilité
f5 = z((close - open) / math.max(high - low, syminfo.mintick)) // force du corps de la bougie

// ─────────────────────────────────────────────
// APPRENTISSAGE EN LIGNE (descente de gradient)
// Les poids ne sont mis à jour qu'avec des labels déjà connus : pas de fuite du futur.
// ─────────────────────────────────────────────
var w     = array.new_float(6, 0.0)   // biais + 5 poids
var xPrev = array.new_float(6, na)
var int trained = 0
xNow = array.from(1.0, f1, f2, f3, f4, f5)

featuresReady = not na(f1) and not na(f2) and not na(f3) and not na(f4) and not na(f5)
float p = na

if barstate.isconfirmed and featuresReady and featuresReady[1]
    // 1) entraînement : les variables de la barre précédente expliquent le sens de la barre actuelle
    s = 0.0
    for i = 0 to 5
        s += w.get(i) * xPrev.get(i)
    pPrev = sigmoid(s)
    // Une clôture inchangée est neutre, pas un succès vendeur.
    y = close > close[1] ? 1.0 : close < close[1] ? 0.0 : 0.5
    err = y - pPrev
    for i = 0 to 5
        w.set(i, w.get(i) + lr * (err * xPrev.get(i) - l2 * w.get(i)))
    trained += 1
    // 2) prédiction pour la PROCHAINE barre
    s2 = 0.0
    for i = 0 to 5
        s2 += w.get(i) * xNow.get(i)
    p := sigmoid(s2)

if barstate.isconfirmed
    xPrev := xNow.copy()

ready = trained >= warmup and not na(p)
thr = thrUp / 100.0
trendUp = close > ema20 and ema20 > ema50
trendDown = close < ema20 and ema20 < ema50
// ATR précédent : une bougie extrême ne relève pas son propre seuil.
atrRef = atr14[1]
rangeOk = not na(atrRef) and atrRef > 0 and high - low <= maxRange * atrRef
extensionOk = not na(atrRef) and math.abs(close - ema20) <= maxExtension * atrRef
var int lastSignalBar = na
pauseOk = na(lastSignalBar) or bar_index - lastSignalBar > cooldown
longSetup = ready and p > 0.5 and p >= thr and (not useTrend or trendUp)
shortSetup = ready and p < 0.5 and p <= 1.0 - thr and (not useTrend or trendDown)
longSignal = barstate.isconfirmed and longSetup and rangeOk and extensionOk and pauseOk
shortSignal = barstate.isconfirmed and shortSetup and rangeOk and extensionOk and pauseOk
direction = longSignal ? 1 : shortSignal ? -1 : 0
if direction != 0
    lastSignalBar := bar_index

// ─────────────────────────────────────────────
// STATISTIQUES DIRECTIONNELLES (hors coûts d'exécution)
// (la prédiction faite à t-1 est comparée au résultat de la barre t)
// ─────────────────────────────────────────────
evaluated = barstate.isconfirmed and not na(p[1])
hit = evaluated and ((p[1] > 0.5 and close > close[1]) or (p[1] < 0.5 and close < close[1]))
conf = barstate.isconfirmed and nz(direction[1], 0) != 0
confHit = conf and ((direction[1] == 1 and close > close[1]) or (direction[1] == -1 and close < close[1]))
// Sommes explicites : la fenêtre reste en barres, même avec des valeurs manquantes.
allN = math.sum(evaluated ? 1.0 : 0.0, statLen)
allHits = math.sum(hit ? 1.0 : 0.0, statLen)
confN = math.sum(conf ? 1.0 : 0.0, statLen)
confHits = math.sum(confHit ? 1.0 : 0.0, statLen)
upN = math.sum(evaluated and close > close[1] ? 1.0 : 0.0, statLen)
accAll = allN > 0 ? 100.0 * allHits / allN : na
accConf = confN > 0 ? 100.0 * confHits / confN : na
upRate = allN > 0 ? 100.0 * upN / allN : na

// ─────────────────────────────────────────────
// AFFICHAGE
// ─────────────────────────────────────────────
pPct = p * 100.0
colP = pPct >= thrUp ? color.green : pPct <= 100.0 - thrUp ? color.red : color.gray
plot(pPct, "P(prochaine bougie haussière) %", color=colP, linewidth=2)
hline(50, "Neutre", color=color.gray, linestyle=hline.style_dashed)
hline(thrUp, "Seuil haussier", color=color.new(color.green, 50))
hline(100.0 - thrUp, "Seuil baissier", color=color.new(color.red, 50))
bgcolor(longSignal ? color.new(color.green, 85) : shortSignal ? color.new(color.red, 85) : na)
plotshape(longSignal, "Signal achat confirmé", shape.triangleup, location.bottom, color.lime, text="ACHAT", size=size.tiny)
plotshape(shortSignal, "Signal vente confirmé", shape.triangledown, location.top, color.red, text="VENTE", size=size.tiny)

// Toutes les lignes décrivent la même clôture. Aucune décision intrabougie.
reason = not ready ? "Apprentissage " + str.tostring(trained) + "/" + str.tostring(warmup) : not rangeOk ? "Bougie trop ample" : not extensionOk ? "Prix trop éloigné EMA 20" : not pauseOk ? "Pause entre signaux" : not (longSetup or shortSetup) ? "Seuil / tendance non alignés" : "Signal pour la prochaine bougie"
var table tbl = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 15), border_width=1)
if barstate.isconfirmed
    decisionColor = longSignal ? color.new(color.green, 15) : shortSignal ? color.new(color.red, 15) : color.new(color.gray, 30)
    table.cell(tbl, 0, 0, "Décision à la clôture", text_color=color.white, bgcolor=decisionColor)
    table.cell(tbl, 1, 0, longSignal ? "ACHAT" : shortSignal ? "VENTE" : "ATTENDRE", text_color=color.white, bgcolor=decisionColor)
    table.cell(tbl, 0, 1, "Motif", text_color=color.white)
    table.cell(tbl, 1, 1, reason, text_color=color.white)
    table.cell(tbl, 0, 2, "Score hausse / baisse*", text_color=color.white)
    table.cell(tbl, 1, 2, pct(pPct) + " / " + pct(100.0 - pPct), text_color=color.white)
    table.cell(tbl, 0, 3, "Tendance / ATR 14", text_color=color.white)
    table.cell(tbl, 1, 3, (trendUp ? "Haussière" : trendDown ? "Baissière" : "Mixte") + " / " + str.tostring(atr14, format.mintick), text_color=color.white)
    table.cell(tbl, 0, 4, "Précision globale / base hausse", text_color=color.white)
    table.cell(tbl, 1, 4, pct(accAll) + " / " + pct(upRate), text_color=color.white)
    table.cell(tbl, 0, 5, "Précision signaux / effectif", text_color=color.white)
    table.cell(tbl, 1, 5, pct(accConf) + " / " + (na(confN) ? "—" : str.tostring(confN, "#")), text_color=color.white)
    table.cell(tbl, 0, 6, "Dernière clôture (UTC)", text_color=color.white)
    table.cell(tbl, 1, 6, str.format_time(time_close, "dd/MM HH:mm", "UTC"), text_color=color.white)
    table.cell(tbl, 0, 7, "*Estimation non calibrée", text_color=color.silver)
    table.cell(tbl, 1, 7, "Direction ≠ rentabilité", text_color=color.silver)
if barstate.islast
    table.cell(tbl, 0, 8, "État", text_color=color.silver)
    table.cell(tbl, 1, 8, barstate.isconfirmed ? "Clôture confirmée" : "Bougie en cours — tableau précédent", text_color=color.silver)

// Alertes (à régler sur « une fois par clôture de barre »)
alertcondition(longSignal, "Scalp achat confirmé", "ACHAT | {{ticker}} | {{interval}} | clôture {{close}} | horizon : prochaine bougie")
alertcondition(shortSignal, "Scalp vente confirmé", "VENTE | {{ticker}} | {{interval}} | clôture {{close}} | horizon : prochaine bougie")
